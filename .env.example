# Copy this file to .env and fill in your values (never commit .env)

# Where booking & contact emails are delivered
INQUIRY_TO=gezeceyik1travel@gmail.com

# Option A — Gmail (recommended): use an App Password, not your normal password
# https://myaccount.google.com/apppasswords
GMAIL_USER=gezeceyik1travel@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Option B — Web3Forms (alternative): https://web3forms.com
# WEB3FORMS_ACCESS_KEY=your_access_key_here

# Local dev server port (optional)
PORT=3000
